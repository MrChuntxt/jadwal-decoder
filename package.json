{
  "name": "jadwal-decoder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.toml"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@preact/preset-vite": "^2.10.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.136.3",
    "@types/babel__core": "^7.20.5"
  }
}
